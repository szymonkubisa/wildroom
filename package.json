{
  "name": "wildroom",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": "github:szymonkubisa/wildroom",
  "description": "Wildroom, an AI film studio for macOS: plan with an AI Director, generate shots, images, voices and music, and cut them on a Final Cut–style magnetic timeline.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:start": "node scripts/build-electron.mjs --stage && electron dist-electron/app",
    "models:ltx": "bash scripts/install-local-ltx.sh",
    "models:ltx-quality": "bash scripts/install-local-ltx.sh --quality",
    "models:flux2": "bash scripts/install-local-flux2.sh",
    "models:flux2-max": "bash scripts/install-local-flux2.sh --max",
    "wildroom:import": "node scripts/wildroom-import.mjs",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fal-ai/client": "^1.10.1",
    "@hono/node-server": "^2.1.1",
    "@lucide/vue": "^1.48.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "^2.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/vue-query": "^5.104.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.13.10",
    "image-size": "^2.0.4",
    "immer": "^11.1.18",
    "mediabunny": "^1.60.0",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
